<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us - Shortly</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <!-- Background Effects -->
    <div class="ambient-glow glow-one"></div>
    <div class="ambient-glow glow-two"></div>
    <nav class="navbar">
      <div class="logo">Shortly</div>

      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/about">About</a>
      </div>
    </nav>

    <main class="about-container">
      <div class="about-heading">
        <span class="hero-badge">GET TO KNOW US</span>

        <h1>About <span>Shortly.</span></h1>

        <p>Making the internet simpler, one link at a time.</p>
      </div>

      <section class="bento-grid">
        <!-- Main About Card -->
        <div class="bento-card bento-main">
          <span class="card-tag">01 / ABOUT SHORTLY</span>

          <h2>Less clutter.<br />More connection.</h2>

          <p>
            Shortly is a simple and powerful URL shortener designed to make
            sharing links faster and easier.
          </p>

          <div class="orbit-animation">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit-core"></div>
          </div>
        </div>

        <!-- Mission Card -->
        <div class="bento-card bento-mission">
          <span class="card-tag">02 / OUR MISSION</span>

          <div class="mission-orb"></div>

          <h2>Built with a purpose.</h2>

          <p>
            I created Shortly to make sharing long links a little less
            frustrating. Something simple, where anyone can shorten a link in
            seconds.
          </p>
        </div>

        <!-- Speed Card -->
        <div class="bento-card bento-speed">
          <span class="card-tag">03 / SPEED</span>

          <div class="speed-animation">
            <div class="speed-ring"></div>
            <span>FAST</span>
          </div>

          <h2>Fast & Simple</h2>
          <p>Shorten your long links in seconds.</p>
        </div>

        <!-- Sharing Card -->
        <div class="bento-card bento-simple">
          <span class="card-tag">04 / SHARING</span>

          <div class="simple-animation">
            <span>LONG URL</span>
            <div class="animated-arrow">↓</div>
            <span class="short-link">SHORT LINK</span>
          </div>

          <h2>Easy to Share</h2>
          <p>Cleaner links. Easier sharing.</p>
        </div>

        <!-- Final Card -->
        <div class="bento-card bento-final">
          <span class="card-tag">05 / SHORTLY</span>

          <h2>Shorten. Copy. Share.</h2>

          <p>One small link can take you anywhere.</p>

          <a href="/" class="about-home-btn"> Try Shortly <span>↗</span> </a>
        </div>
      </section>
    </main>
  </body>
</html>
